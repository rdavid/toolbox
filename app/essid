#!/bin/sh
# vi: lbr noet sw=2 ts=2 tw=79 wrap
# SPDX-FileCopyrightText: 2020-2026 David Rabkin
# SPDX-License-Identifier: 0BSD
#
# Watches for Wi-Fi ESSID changes and reports them.
#
# The script uses local variables, which POSIX does not define but most
# shells support. See:
#  https://stackoverflow.com/q/18597697
#
# Shellcheck cannot follow the sourced file, flags its variables as unused,
# and warns about local:
#  shellcheck disable=SC1091,SC2034,SC2039,SC3043
readonly BASE_APP_VERSION=0.9.20261127
. base.sh
readonly \
	CUR="$BASE_WIP"/cur \
	OLD="$BASE_WIP"/old

# Reports ESSID changes in a loop.
main() {
	validate
	loop
}

# Compares current and previous ESSID lists and logs any changes.
comp() {
	local chg
	chg="$(
		diff \
			--side-by-side \
			--suppress-common-lines \
			"$CUR" \
			"$OLD" |
			wc -l |
			tr -d ' '
	)"
	if [ "$chg" -ne 0 ]; then
		log "ESSID list changed, $chg lines differ. Alert!"
	else
		log ESSID list is unchanged.
	fi
}

# Saves the current ESSID list to OLD.
copy() {
	cmd_run cp -f "$CUR" "$OLD"
}

# Scans available ESSIDs and writes them to CUR.
list() {
	iwlist wlan0 s | grep ESSID | tr -s ' ' | cut -d : -f 2 >"$CUR"
}

# Scans and compares ESSID lists continuously.
loop() {
	list
	while :; do
		pause
		copy
		list
		comp
	done
}

# Pauses between scans.
pause() {
	sleep 5
}

# Validates the environment.
validate() {
	beroot
	cmd_exists iwlist || die
}

# Entry point.
main "$@"
