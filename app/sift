#!/bin/sh
# vi: lbr noet sw=2 ts=2 tw=79 wrap
# SPDX-FileCopyrightText: 2026 David Rabkin
# SPDX-License-Identifier: 0BSD
#
# Copies a random subset of files from the given source directory into a
# destination directory until a configurable byte budget is reached.
#
# Usage: sift [-s|--size=N[K|M|G]] [-o|--output=DIR] SRC
#
# The script uses local variables which are not POSIX but supported by most
# shells. See:
#  https://stackoverflow.com/q/18597697
#  shellcheck disable=SC1091,SC2034,SC2039,SC3043
BASE_APP_USAGE="$(
	cat <<-EOM 2>&1
		  -s, --size        Byte budget with optional K/M/G suffix, e.g. -s 512M
		                    (default 8G).
		  -o, --output      Destination directory (default current directory).
		  SRC               Source directory to copy files from.
	EOM
)" || {
	err=$?
	printf >&2 '%s\n' "$BASE_APP_USAGE"
	exit $err
}
readonly BASE_APP_VERSION=0.9.20260916
. base.sh

# Picks files from SRC in random order and copies them into DST until the
# byte budget is reached. Reports per-file progress and a final summary.
main() {
	DST=.
	MAX=$((8 * 1024 * 1024 * 1024))
	parse "$@"
	readonly DST MAX SRC
	validate
	NO=0
	OK=0
	SUM=0
	scan
	report
}

# Parses CLI arguments into the globals DST, MAX, and SRC. Dies via usage()
# on a second positional argument, since SRC accepts exactly one.
parse() {
	while [ "$#" -gt 0 ]; do
		case "$1" in
		-s | --size)
			[ "$#" -ge 2 ] || usage
			MAX="$(parse_size "$2")"
			shift 2
			;;
		--size=*)
			MAX="$(parse_size "${1#--size=}")"
			shift
			;;
		-o | --output)
			[ "$#" -ge 2 ] || usage
			DST="$2"
			shift 2
			;;
		--output=*)
			DST="${1#--output=}"
			shift
			;;
		-*) usage ;;
		*)
			[ -z "${SRC:-}" ] || usage
			SRC="$1"
			shift
			;;
		esac
	done
}

# Parses a size string like "8G", "512M", "10K" into a byte count. A bare
# number is treated as bytes; the suffix is case-insensitive. Malformed
# input falls through to an arithmetic error.
parse_size() {
	local mul str="$1"
	case "$str" in
	*[Kk]) mul=1024 ;;
	*[Mm]) mul=$((1024 * 1024)) ;;
	*[Gg]) mul=$((1024 * 1024 * 1024)) ;;
	*) mul=1 ;;
	esac
	printf %s "$((${str%[KkMmGg]} * mul))"
}

# Copies a single file when it fits in the remaining budget; updates the
# running total and per-file counters.
process() {
	local fle="$1" out sze
	sze="$(wc -c <"$fle" 2>&1)" || {
		NO=$((NO + 1))
		logw no "$fle: $sze"
		return
	}
	[ "$((SUM + sze))" -le "$MAX" ] || return 1
	out="$(cp -p -- "$fle" "$DST"/ 2>&1)" || {
		NO=$((NO + 1))
		logw no "$fle: $out"
		return
	}
	SUM=$((SUM + sze))
	OK=$((OK + 1))
	log ok "${fle##*/}: $((SUM / 1024 / 1024)) MB total."
}

# Prints a final ok/no summary, or a notice when no files were seen.
report() {
	[ "$NO" -eq 0 ] && [ "$OK" -eq 0 ] && {
		log No files to sift.
		return 0
	}
	log "ok/no: $OK/$NO, $((SUM / 1024 / 1024)) MB."
}

# Scans SRC for files in random order and feeds each to process() until the
# budget is full. The list is staged in a file rather than piped, so the
# read loop runs in the current shell and its updates to NO/OK/SUM are not
# lost to a subshell.
scan() {
	local fle lst="$BASE_WIP"/list
	find "$SRC" -type f | shuf >"$lst"
	while read -r fle; do
		process "$fle" || break
	done <"$lst"
}

# Prints the usage hint and exits.
usage() {
	cya 'sift: usage is sift [-s|--size=N[K|M|G]] [-o|--output=DIR] SRC.'
}

# Validates the environment and the parsed arguments used by scan() and
# process().
validate() {
	cmd_exists shuf || die
	[ -n "${SRC:-}" ] || usage
	isreadable "$SRC" || die SRC "$SRC" is not readable.
	iswritable "$DST" || die DST "$DST" is not writable.
}

# Entry point.
main "$@"
