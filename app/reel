#!/bin/sh
# vi: lbr noet sw=2 ts=2 tw=79 wrap
# SPDX-FileCopyrightText: 2026 David Rabkin
# SPDX-License-Identifier: 0BSD
#
# Converts a video file to a vertical short-form reel.
#
# The script uses local variables, which POSIX does not define but most
# shells support. See:
#  https://stackoverflow.com/q/18597697
#
# Shellcheck cannot follow the sourced file, flags its variables as unused,
# and warns about local:
#  shellcheck disable=SC1091,SC2034,SC2039,SC3043
BASE_APP_USAGE="$(
	cat <<-EOM 2>&1
		  -c, --crop        Crop the center to fill the frame instead of padding.
		  -f, --file        Input file name (default input.mp4).
		  -o, --output      Output file name (default is the input file
		                    base name plus an incrementing number, e.g.
		                    input-1.mp4).
		  -r, --transcribe  Burn subtitles transcribed by whisper-cli with the
		                    model at ~/ggml.bin.
		  -s, --start       Start time, e.g. -s 00:00:05.00 (default 00:00:00.00).
		  -u, --duration    Clip duration, e.g. -u 00:00:15.00 (default 00:00:20.00).
		  -z, --shift       Horizontal crop shift in pixels with --crop, may be
		                    negative (default 0).
	EOM
)" || {
	err=$?
	printf >&2 '%s\n' "$BASE_APP_USAGE"
	exit $err
}
readonly \
	BASE_APP_VERSION=0.9.20261107 \
	BASE_MIN_VERSION=0.9.20260707
. base.sh

# Validates the environment and converts the input video.
main() {
	validate "$@"
	process
}

# Checks that $1 is non-empty and not a flag, then assigns it to $3. A
# leading minus followed by a digit is accepted as a negative number rather
# than rejected as a flag.
need() {
	case "${1:-}" in
	'' | - | -[!0-9]*) die "$2 requires a non-empty argument." ;;
	esac
	eval "${3}=\"\${1}\""
}

# Builds a default output file name from the input file's base name plus an
# incrementing number, skipping any name that already exists.
outname() {
	local bas num=1 try
	bas="$(basename -- "$FLE" 2>&1)" || die "$bas"
	bas="${bas%.*}"
	try="$bas-$num.mp4"
	while file_exists "$try"; do
		num=$((num + 1))
		try="$bas-$num.mp4"
	done
	printf %s "$try"
}

# Parses command-line arguments, consuming each option's value and dying on
# anything unrecognized.
parse() {
	while [ $# -gt 0 ]; do
		case "$1" in
		-c | --crop) CRP=true ;;
		-f | --file)
			need "${2:-}" --file FLE
			shift
			;;
		-o | --output)
			need "${2:-}" --output OUT
			shift
			;;
		-r | --transcribe) TRN=true ;;
		-s | --start)
			need "${2:-}" --start STA
			shift
			;;
		-u | --duration)
			need "${2:-}" --duration DUR
			shift
			;;
		-z | --shift)
			need "${2:-}" --shift SHF
			shift
			;;
		*) die Unknown parameter "$1". ;;
		esac
		shift
	done
}

# Converts the input video to a vertical reel. With --crop the center of the
# video fills the frame. Otherwise the scaled video overlays its blurred
# copy. With --transcribe the subtitles are burned in near the bottom. The
# ffmpeg options are sorted alphabetically, except -ss stays before -i for
# fast input seeking and the output file stays last.
process() {
	local vfl
	if [ "$CRP" = true ]; then
		vfl="\
       crop='min(iw,ih*1080/1920)': \
       'min(ih,iw*1920/1080)': \
       '(iw-ow)/2+$SHF': \
       '(ih-oh)/2', \
       scale=1080:1920, \
       setsar=1 \
       "
	else
		vfl="\
       [0:v]split=2[bg][fg]; \
       [bg]scale=1080:1920, \
       setsar=1, \
       boxblur=20[blurred]; \
       [fg]scale=1080:-2[scaled]; \
       [blurred][scaled]overlay=(W-w)/2:(H-h)/2 \
       "
	fi
	[ "$TRN" = false ] || {
		transcribe
		vfl="$vfl, subtitles=\
filename='$BASE_WIP/audio.srt':\
force_style='\
Alignment=2,\
BorderStyle=1,\
FontSize=14,\
MarginV=15,\
Outline=1':\
wrap_unicode=0"
	}
	cmd_run ffmpeg -y \
		-ss "$STA" \
		-i "$FLE" \
		-c:a aac -b:a 192k \
		-c:v libx264 -preset fast -crf 23 \
		-t "$DUR" \
		-vf "$vfl" \
		"$OUT"
}

# Extracts the clip's audio as 16 kHz mono WAV, which whisper-cli expects,
# and transcribes it into $BASE_WIP/audio.srt. Each cue holds at most 48
# characters split on words, which keeps about two lines on screen for a
# few seconds. A wider beam search than the default of five trades a little
# speed for accuracy.
transcribe() {
	cmd_run ffmpeg -y \
		-ss "$STA" \
		-i "$FLE" \
		-ac 1 -ar 16000 -c:a pcm_s16le \
		-t "$DUR" \
		-vn \
		"$BASE_WIP"/audio.wav
	cmd_run whisper-cli \
		--beam-size 8 \
		--best-of 8 \
		--file "$BASE_WIP"/audio.wav \
		--language auto \
		--max-len 48 \
		--model "$MDL" \
		--no-prints \
		--output-file "$BASE_WIP"/audio \
		--output-srt \
		--split-on-word
}

# Validates the environment and sets defaults.
validate() {
	cmd_exists ffmpeg || die
	parse "$@"
	var_exists CRP || CRP=false
	var_exists DUR || DUR=00:00:20.00
	var_exists FLE || FLE=input.mp4
	var_exists OUT || OUT="$(outname)"
	var_exists SHF || SHF=0
	var_exists STA || STA=00:00:00.00
	var_exists TRN || TRN=false
	readonly \
		CRP \
		DUR \
		FLE \
		MDL="$HOME"/ggml.bin \
		OUT \
		SHF \
		STA \
		TRN
	isnumber "${SHF#-}" || die --shift requires an integer.
	[ "$CRP" = true ] || [ "$SHF" -eq 0 ] || die --shift requires --crop.
	isreadable "$FLE" || die "$FLE" is not readable.
	iswritable "$(dirname "$OUT")" || die "$OUT" is not writable.
	[ "$TRN" = false ] || {
		cmd_exists whisper-cli || die
		cmd_run sh -c 'ffmpeg -hide_banner -filters | grep subtitles' ||
			die ffmpeg lacks the subtitles filter, which requires libass.
		isreadable "$MDL" ||
			die Whisper model "$MDL" is not readable. \
				Download it with: curl \
				--location \
				--output "$MDL" \
				https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3.bin
	}
}

# Entry point.
main "$@"
